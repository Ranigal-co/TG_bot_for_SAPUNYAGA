# Токен от @BotFather
BOT_TOKEN=123456789:AAF...

# Слово-триггер (без учёта регистра, целое слово)
TRIGGER_WORD=почему

# 1 = отвечать только на вопросы с вопросительным знаком
REQUIRE_QUESTION_MARK=0

# Антиспам: минимальный интервал между кружками в одном чате, сек. 0 = выключить
COOLDOWN_SECONDS=30

# 1 = работать только в группах/супергруппах
WORK_ONLY_IN_GROUPS=1

# ID чатов, где бот работает. Пусто = все чаты. Пример: -1001234567890,-1009876543210
ALLOWED_CHAT_IDS=

# ID Telegram-админов, которым можно менять кружок. Пусто = любой в личке (не рекомендуется)
ADMIN_IDS=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
